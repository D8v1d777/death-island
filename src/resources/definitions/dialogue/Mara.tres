[gd_resource type="Resource" script_class="DialogueDefinition" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/data/DialogueDefinition.gd" id="script"]
[resource]
script = ExtResource("script")
speaker = "Mara · ship's engineer, 32"
introduction = "The tide took the ship. It doesn't get to take us too. I'm Mara. That broken beacon on the shore is our best chance, but first we need fire, food and a reason to trust each other."
endings = {
"together": "DAWN, TOGETHER\n\nThe beacon cuts through the storm. Mara holds the antenna steady as the rescue boat approaches. You leave the island with scars, and with someone who knows what they cost.\n\nYou chose trust when survival made it difficult.",
"alone": "THE LAST PASSENGER\n\nA single flare. A single passenger. Behind you, the island shrinks into the mist. Your pack is heavy; the empty seat beside you is heavier.\n\nYou survived. You will decide what that means.",
"stay": "KEEPER OF THE SHORE\n\nYou switch the beacon to a warning signal. No more ships on these rocks. For now, the shelter is home and the island is a responsibility you choose.\n\nSome escapes begin by staying."
}
