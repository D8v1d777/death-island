[gd_resource type="Resource" script_class="ContentPack" load_steps=6 format=3]
[ext_resource type="Script" path="res://scripts/data/ContentPack.gd" id="pack"]
[ext_resource type="Script" path="res://scripts/data/QuestDefinition.gd" id="quest"]
[sub_resource type="Resource" id="kindling"]
script = ExtResource("quest")
quest_id = "kindling"
title = "A Fire Between Strangers"
description = "Mara survived the wreck too. Gather 4 driftwood and 3 stone to prepare a fire. Decide whether to share the supplies."
costs = {"wood": 4, "stone": 3}
choices = Array[Dictionary]([
{"id":"share","label":"Share the fire and supplies","trust":2,"rewards":{"campfire_kit":1,"water":2},"text":"Mara: You could have left me in the rain. I won't forget this. Ask me to travel with you."},
{"id":"keep","label":"Keep the supplies for yourself","trust":-1,"rewards":{"bandage":2},"text":"Mara: Then we survive separately. But neither of us can repair that beacon alone."}
])
[sub_resource type="Resource" id="signal"]
script = ExtResource("quest")
quest_id = "signal"
title = "Voices in the Stone"
prerequisite = "kindling"
description = "Find 3 radio parts in the cave northwest of the beach. Bring them to Mara. The cliffs hold iron ore for stronger equipment."
costs = {"scrap":3}
choices = Array[Dictionary]([
{"id":"honest","label":"Tell Mara what happened in the cave","trust":2,"rewards":{"iron_ingot":2,"bandage":2},"text":"Mara: The old expedition heard that signal too. We can still choose a different ending."},
{"id":"bargain","label":"Demand supplies before handing over the parts","trust":-1,"rewards":{"iron_ingot":4,"cooked_meat":3},"text":"Mara: Take them. Just remember who paid for your way off this island."}
])
[sub_resource type="Resource" id="guardian"]
script = ExtResource("quest")
quest_id = "guardian"
title = "The Last Watch"
prerequisite = "signal"
description = "Defeat the Ruins Guardian in the northeast. Bring one signal crystal to Mara, then return to the beach beacon with 3 iron ingots and 2 fiber."
costs = {"crystal":1}
kill_target = "guardian"
choices = Array[Dictionary]([
{"id":"rescue","label":"Promise to call rescue for everyone","trust":2,"rewards":{"crystal":1,"water":3},"text":"Mara: Then light it. For everyone who never made it to the shore."},
{"id":"alone","label":"Say you will leave on your own terms","trust":-2,"rewards":{"crystal":1,"cooked_meat":3},"text":"Mara: You have your signal. I hope it is enough to live with."}
])
[resource]
script = ExtResource("pack")
entries = Array[Resource]([SubResource("kindling"),SubResource("signal"),SubResource("guardian")])
