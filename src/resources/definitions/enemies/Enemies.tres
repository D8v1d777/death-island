[gd_resource type="Resource" script_class="ContentPack" load_steps=7 format=3]
[ext_resource type="Script" path="res://scripts/data/ContentPack.gd" id="pack"]
[ext_resource type="Script" path="res://scripts/data/enemy_definition.gd" id="enemy"]
[ext_resource type="Resource" path="res://resources/definitions/enemies/wild_boar.tres" id="boar"]

[sub_resource type="Resource" id="wolf"]
script = ExtResource("enemy")
enemy_id = "wolf"
display_name = "Ash Wolf"
max_health = 70.0
attack_damage = 15.0
move_speed = 4.0
windup = 0.65
behavior = "circle"
tint = Color(0.42,0.49,0.54,1)
body_size = Vector3(0.65,0.8,1.5)
loot_table = Array[Dictionary]([{"item_id":"raw_meat","count":2,"chance":1.0},{"item_id":"hide","count":3,"chance":1.0}])
[sub_resource type="Resource" id="spider"]
script = ExtResource("enemy")
