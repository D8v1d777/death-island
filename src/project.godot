config_version=5

[application]
config/name="Death Island"
config/description="An offline survival adventure about trust and escape."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/Icon.svg"
config/version="0.3.0-dev-rc1"

[autoload]
LoggerGlobal="*res://scripts/autoloads/LoggerGlobal.gd"
DataCatalogGlobal="*res://scripts/autoloads/DataCatalogGlobal.gd"
InputManagerGlobal="*res://scripts/autoloads/InputManagerGlobal.gd"
AudioManagerGlobal="*res://scripts/autoloads/AudioManagerGlobal.gd"
CraftingSystemGlobal="*res://scripts/systems/crafting_system_global.gd"
CombatSystemGlobal="*res://scripts/systems/combat_system_global.gd"
ResourceSystemGlobal="*res://scripts/systems/resource_system_global.gd"
SurvivalSystemGlobal="*res://scripts/systems/survival_system_global.gd"
QuestSystemGlobal="*res://scripts/systems/QuestSystemGlobal.gd"
RelationshipSystemGlobal="*res://scripts/systems/RelationshipSystemGlobal.gd"
PartySystemGlobal="*res://scripts/systems/PartySystemGlobal.gd"
BaseStorageGlobal="*res://scripts/systems/BaseStorageGlobal.gd"
FarmingSystemGlobal="*res://scripts/systems/FarmingSystemGlobal.gd"
SaveManagerGlobal="*res://scripts/autoloads/SaveManagerGlobal.gd"
GameManagerGlobal="*res://scripts/autoloads/GameManagerGlobal.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_backward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
look_left={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0)]}
look_right={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0)]}
look_up={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0)]}
look_down={"deadzone":0.2,"events":[Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0)]}
attack_light={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":1),Object(InputEventJoypadButton,"button_index":2)]}
attack_heavy={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":2),Object(InputEventJoypadButton,"button_index":3)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32),Object(InputEventJoypadButton,"button_index":1)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325),Object(InputEventJoypadButton,"button_index":7)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventJoypadButton,"button_index":0)]}
inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194306),Object(InputEventJoypadButton,"button_index":4)]}
crafting={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
journal={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74)]}
pause={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305),Object(InputEventJoypadButton,"button_index":6)]}
quick_food={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
quick_water={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
quick_heal={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":51)]}
quick_weapon={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":52)]}

[input_devices]
pointing/emulate_mouse_from_touch=true

[layer_names]
3d_physics/layer_1="Player"
3d_physics/layer_2="Enemies"
3d_physics/layer_3="NPCs"
3d_physics/layer_4="Resources"
3d_physics/layer_5="World"
3d_physics/layer_7="Pickups"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.04,0.12,0.16,1)

[audio]
default_bus_layout="res://resources/DefaultBusLayout.tres"
